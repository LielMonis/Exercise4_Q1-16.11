QMainWindow {
    background-color: #f4f6f8;
}

QPushButton {
    background-color: #22b55f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #1e9e52;
}

QPushButton:pressed {
    background-color: #17803f;
}

QLabel {
    font-size: 14px;
}

QSpinBox {
    padding: 4px;
    font-size: 14px;
    min-width: 80px;
}

QTableWidget {
    background-color: white;
    alternate-background-color: #f3faf5;
    gridline-color: #e3ede4;
    font-size: 13px;
}

QTableWidget::item:selected {
    background-color: #c8eed3;
    color: black;
}

QHeaderView::section {
    background-color: #91dda8;
    padding: 6px;
    font-weight: bold;
    border: 1px solid #91dda8;
}
